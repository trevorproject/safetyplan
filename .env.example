# Firebase web app config: Firebase Console -> Project settings -> General ->
# Your apps -> SDK setup and configuration -> Config.
# Copy this file to .env and fill in the values. .env is git-ignored.
# Note: Vite embeds these values in the built site, so they are not secrets;
# what protects the data is firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
